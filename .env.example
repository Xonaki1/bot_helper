# Django
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DB_NAME=taskbot
DB_USER=taskbot
DB_PASSWORD=taskbot_password
DB_HOST=db
DB_PORT=5432

# Telegram
BOT_TOKEN=your-bot-token-here

# Webhook (for production)
WEBHOOK_HOST=https://yourdomain.com
WEBHOOK_PATH=/webhook/

# For local polling mode (set to True for local dev without webhook)
USE_POLLING=True
